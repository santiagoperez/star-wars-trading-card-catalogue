{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/card.schema.json",
  "title": "Star Wars Topps card",
  "description": "Mechanized source data for one card in the Star Wars Topps catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "year",
    "collection",
    "number",
    "title"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "year": {
      "type": "integer",
      "minimum": 1900
    },
    "collection": {
      "type": "string",
      "minLength": 1
    },
    "number": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "section": { "$ref": "#/$defs/nonEmptyString" },
    "subtitle": { "$ref": "#/$defs/nonEmptyString" },
    "franchise": { "$ref": "#/$defs/nonEmptyString" },
    "insert_collection": { "$ref": "#/$defs/nonEmptyString" },
    "description": { "$ref": "#/$defs/nonEmptyString" },
    "front_description": { "$ref": "#/$defs/nonEmptyString" },
    "back_description": { "$ref": "#/$defs/nonEmptyString" },
    "species": { "$ref": "#/$defs/nonEmptyString" },
    "home_world": { "$ref": "#/$defs/nonEmptyString" },
    "affiliation": { "$ref": "#/$defs/nonEmptyStringList" },
    "notes": { "$ref": "#/$defs/nonEmptyStringList" }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "uniqueItems": true
    }
  }
}
